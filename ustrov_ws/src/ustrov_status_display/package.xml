<?xml version="1.0"?>
<package format="3">
  <name>ustrov_status_display</name>
  <version>0.1.0</version>
  <description>Read-only SSD1306 onboard status display for USTROV.</description>
  <maintainer email="jwangma@ustrov.local">USTROV</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>ustrov_control_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
